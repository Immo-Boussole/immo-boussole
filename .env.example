# ── Immo-Boussole Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in the values

# Build version to force recreation of docker image (override 'latest')
APP_VERSION=1.1.2

# Application Environment (production or development)
# This prefixes email subjects with [DEV] and isolates Docker volumes.
APP_ENV=production

# Application Domain and URL (used for absolute links and webhooks)
# Examples: localhost, immo-prod.local, my-domain.com
APP_DOMAIN=localhost
APP_URL=http://localhost:8000

# Docker Compose Project Name (use immo-prod or immo-dev to avoid container conflicts)
COMPOSE_PROJECT_NAME=immo-prod

# Database (absolute path for Docker, relative for local development)
# Local development (default): sqlite:///./immo_boussole.db
# Docker: sqlite:////app/data/immo_boussole.db
DATABASE_URL=sqlite:///./immo_boussole.db

# Browserless service URL (headless Chrome via CDP)
# Local development: ws://localhost:3000
# Docker: ws://browserless:3000
BROWSERLESS_URL=ws://localhost:3000

# Browserless authentication token (optional)
# If defined, all CDP connections must include this token
BROWSERLESS_TOKEN=

# Proxy chains configured as a JSON string (optional)
# Ordinal list of proxies to use for each platform. Falls back to next proxy in case of block/error.
# Format: '{"leboncoin": ["direct", "http://gost-client:1080"], "default": ["direct"]}'
# If not defined, defaults to '{"default": ["direct"]}' (runs entirely without proxy).
# SCRAPING_PROXIES='{"leboncoin": ["direct", "http://gost-client:1080"], "default": ["direct"]}'

# Gost Proxy Upstream URL (Optional - secure WebSocket tunnel to home proxy)
# Decomposed variables:
# PROXY_USER=admin
# PROXY_PASSWORD=mon_mot_de_passe_securise
# PROXY_DOMAIN=proxy.votredomaine.fr
# GOST_UPSTREAM_URL="wss://${PROXY_USER}:${PROXY_PASSWORD}@${PROXY_DOMAIN}:443"

# Automatic scraping interval (in hours)
SCRAPING_INTERVAL_HOURS=12

# Global Apprise URL (optional)
# System-wide push notification channel (used if a user doesn't set a personal one)
APPRISE_URL=

# ScrapingBee API key (optional - fallback alternative)

# Debug mode (false in production)
DEBUG=false

# Authentication
APP_PASSWORD=your_password
SECRET_KEY=a_very_long_and_random_secret_key
